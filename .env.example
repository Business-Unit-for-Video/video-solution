# YouTube Cookies
YOUTUBE_COOKIES_PATH=cookies.txt

# API Keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
HF_TOKEN=hf_your-huggingface-token-here

# GPT-SoVITS
GPT_SOVITS_API_URL=http://127.0.0.1:9880
GPT_SOVITS_PATH=./GPT-SoVITS

# Wav2Lip
WAV2LIP_PATH=./Wav2Lip
WAV2LIP_CHECKPOINT=checkpoints/wav2lip_gan.pth

# Processing Options
DEVICE=cuda  # cuda or cpu
WHISPER_MODEL=large-v2
BATCH_SIZE=16
VIDEO_QUALITY=23  # CRF value (lower=better, 18-28 recommended)

# Sensitive Word Filtering
SENSITIVE_WORDLIST=data/sensitive_words.txt
CENSOR_MODE=beep  # mute or beep
